{
  "manifest_version": 3,
  "name": "WebMCP Bridge",
  "version": "1.3.4",
  "description": "Bridges a local opencode MCP server to your Chrome browser so it can read and interact with the current page.",
  "permissions": ["tabs", "scripting", "activeTab", "storage", "alarms", "debugger"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-main.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content-isolated.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WebMCP Bridge"
  }
}
